@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: Apache-2.0
+
+//! GraphTok backend in dispatcher mode (DYN_GRAPHTOK_DISPATCH=1): token ids
+//! from many threads at once must equal HuggingFace's. Runs only when
+//! GTOK_TEST_LIB (a built libgtok.so) and GTOK_TEST_VOCAB (a tokenizer.json
+//! it supports) are set; needs a GPU.
+
+use dynamo_tokenizers::{GraphTokTokenizer, HuggingFaceTokenizer, traits::Encoder};
+
+#[test]
+fn dispatcher_mode_matches_huggingface_under_concurrency() {
+    let (Ok(lib), Ok(vocab)) = (std::env::var("GTOK_TEST_LIB"), std::env::var("GTOK_TEST_VOCAB")) else {
+        eprintln!("skipped: set GTOK_TEST_LIB and GTOK_TEST_VOCAB");
+        return;
+    };
+    // SAFETY: set before any other thread exists in this test binary's test.
+    unsafe {
+        std::env::set_var("DYN_GRAPHTOK_LIB", &lib);
+        std::env::set_var("DYN_GRAPHTOK_DISPATCH", "1");
+        std::env::set_var("DYN_GRAPHTOK_DISPATCH_CPU_WORKERS", "2");
+    }
+    let gt = GraphTokTokenizer::from_file(&vocab).expect("load GraphTok in dispatcher mode");
+    let hf = HuggingFaceTokenizer::from_file(&vocab).expect("load HF");
+    let base = "The quick brown fox, 12345 times.\n\tdef f(x): return x ** 2  # caf\u{e9} \u{65e5}\u{672c}\u{8a9e} ";
+    let inputs: Vec<String> = (0..96).map(|i| base.repeat(1 + (i * 37) % 400)).collect();
+    std::thread::scope(|s| {
+        for chunk in inputs.chunks(6) {
+            let (gt, hf) = (&gt, &hf);
+            s.spawn(move || {
+                for text in chunk {
+                    let got = gt.encode(text).unwrap();
+                    let want = hf.encode(text).unwrap();
+                    assert_eq!(got.token_ids(), want.token_ids(), "{} bytes", text.len());
+                }
+            });
+        }
+    });
+}
