+// SPDX-License-Identifier: Apache-2.0
+
+//! GraphTok backend: GPU BPE encoding via `libgtok.so`, the C ABI of the
+//! GraphTok (cuTokenize) GPU tokenizer. Any library exposing the same three
+//! functions (`gtok_create`, `gtok_encode`, `gtok_destroy`) can be loaded in
+//! its place through `DYN_GRAPHTOK_LIB`.
+//!
+//! Like [`crate::FastTokenizer`], this is a hybrid: GraphTok encodes, and
+//! HuggingFace decodes. Both are loaded from the same `tokenizer.json`.
+//!
+//! The library is loaded at runtime with `dlopen`, so Dynamo neither links
+//! against CUDA nor requires a GPU unless this backend is selected. A GraphTok
+//! context is single-threaded, so the backend keeps a small pool of contexts
+//! on one GPU and hands one to each concurrent `encode` call; frontend worker
+//! threads beyond the pool size wait for a free context.
+//!
+//! Environment:
+//! - `DYN_GRAPHTOK_LIB`       path to `libgtok.so` (default: `libgtok.so` on the loader path)
+//! - `DYN_GRAPHTOK_CONTEXTS`  contexts in the pool (default 4)
+//! - `DYN_GRAPHTOK_MAX_BYTES` largest input a context is sized for (default 2 MiB);
+//!   larger inputs are encoded by the HuggingFace tokenizer instead
+//! - `DYN_GRAPHTOK_DISPATCH=1` use the library's load-adaptive dispatcher
+//!   (`gtok_dispatcher_create` / `gtok_dispatch_encode`) instead of the context
+//!   pool: one thread-safe object that combines concurrent requests into GPU
+//!   batches and runs small ones on `DYN_GRAPHTOK_DISPATCH_CPU_WORKERS` CPU
+//!   engines (default 1) when one is free
+//!
+//! Correctness: construction encodes a probe containing chat-template special
+//! tokens with both GraphTok and HuggingFace and refuses to load if the token
+//! ids differ. Any per-call GraphTok error also falls back to HuggingFace, so
+//! a request never fails because of this backend.
+
+use std::ffi::{CString, c_char, c_void};
+use std::sync::{Condvar, Mutex};
+
+use libloading::Library;
+
+use super::{
+    Encoding, Error, Result, TokenIdType,
+    hf::HuggingFaceTokenizer,
+    traits::{DecodeResult, Decoder, Encoder, Tokenizer},
+};
+
+type CreateFn = unsafe extern "C" fn(*const c_char, u32) -> *mut c_void;
+type EncodeFn = unsafe extern "C" fn(*mut c_void, *const u8, u32, *mut u32, u32) -> i32;
+type DestroyFn = unsafe extern "C" fn(*mut c_void);
+type DispatcherCreateFn = unsafe extern "C" fn(*const c_char, u32, u32, u32, u32) -> *mut c_void;
+
+const DEFAULT_CONTEXTS: usize = 4;
+const DEFAULT_MAX_BYTES: u32 = 2 << 20;
+
+/// Probe for the construction-time equivalence check: plain text, digits,
+/// whitespace runs and the Qwen/ChatML special tokens a chat request carries.
+const PROBE: &str = "<|im_start|>system\nYou are a helpful assistant.<|im_end|>\n\
+                     <|im_start|>user\nGraphTok probe 12345,  tabs\tand   spaces.\n\
+                     def f(x): return x ** 2  # code<|im_end|>\n<|im_start|>assistant\n";
+
+/// One GraphTok context. Used by one thread at a time.
+struct Ctx {
+    handle: *mut c_void,
+}
+
+// SAFETY: a context is only ever used by the thread that took it from the pool.
+unsafe impl Send for Ctx {}
+
+/// The library's dispatcher: one object, safe to call from every thread.
+struct Dispatch {
+    handle: *mut c_void,
+    encode_fn: EncodeFn,
+    destroy_fn: DestroyFn,
+}
+
+// SAFETY: gtok_dispatch_encode is documented thread-safe; the handle is only
+// destroyed in Drop, after every call has returned.
+unsafe impl Send for Dispatch {}
+unsafe impl Sync for Dispatch {}
+
+pub struct GraphTokTokenizer {
+    // Declared before `_lib` so contexts are destroyed while the library is loaded.
+    dispatch: Option<Dispatch>,
+    pool: Mutex<Vec<Ctx>>,
+    available: Condvar,
+    encode_fn: EncodeFn,
+    destroy_fn: DestroyFn,
+    max_bytes: u32,
+    hf_decoder: HuggingFaceTokenizer,
+    _lib: Library,
+}
+
+impl GraphTokTokenizer {
+    pub fn from_file(path: &str) -> Result<Self> {
+        let lib_path = std::env::var("DYN_GRAPHTOK_LIB").unwrap_or_else(|_| "libgtok.so".into());
+        let contexts = std::env::var("DYN_GRAPHTOK_CONTEXTS")
+            .ok()
+            .and_then(|s| s.parse::<usize>().ok())
+            .filter(|&n| n > 0)
+            .unwrap_or(DEFAULT_CONTEXTS);
+        let max_bytes = std::env::var("DYN_GRAPHTOK_MAX_BYTES")
+            .ok()
+            .and_then(|s| s.parse::<u32>().ok())
+            .unwrap_or(DEFAULT_MAX_BYTES);
+
+        // SAFETY: loading a library runs its initialisers; libgtok's are CUDA runtime setup.
+        let lib = unsafe { Library::new(&lib_path) }
+            .map_err(|e| Error::msg(format!("Error loading {lib_path}: {e}")))?;
+        let (create_fn, encode_fn, destroy_fn) = unsafe {
+            let sym = |name: &[u8]| {
+                Error::msg(format!(
+                    "{lib_path} has no symbol {}",
+                    String::from_utf8_lossy(&name[..name.len() - 1])
+                ))
+            };
+            (
+                *lib.get::<CreateFn>(b"gtok_create\0").map_err(|_| sym(b"gtok_create\0"))?,
+                *lib.get::<EncodeFn>(b"gtok_encode\0").map_err(|_| sym(b"gtok_encode\0"))?,
+                *lib.get::<DestroyFn>(b"gtok_destroy\0").map_err(|_| sym(b"gtok_destroy\0"))?,
+            )
+        };
+
+        let c_path = CString::new(path).map_err(|e| Error::msg(format!("Bad tokenizer path: {e}")))?;
+        let dispatch = if std::env::var("DYN_GRAPHTOK_DISPATCH").is_ok_and(|v| v == "1") {
+            let cpu_workers = std::env::var("DYN_GRAPHTOK_DISPATCH_CPU_WORKERS")
+                .ok()
+                .and_then(|s| s.parse::<u32>().ok())
+                .unwrap_or(1);
+            let (dcreate, dencode, ddestroy) = unsafe {
+                let missing = |n: &str| Error::msg(format!("{lib_path} has no symbol {n}"));
+                (
+                    *lib.get::<DispatcherCreateFn>(b"gtok_dispatcher_create\0")
+                        .map_err(|_| missing("gtok_dispatcher_create"))?,
+                    *lib.get::<EncodeFn>(b"gtok_dispatch_encode\0")
+                        .map_err(|_| missing("gtok_dispatch_encode"))?,
+                    *lib.get::<DestroyFn>(b"gtok_dispatcher_destroy\0")
+                        .map_err(|_| missing("gtok_dispatcher_destroy"))?,
+                )
+            };
+            // policy 0 = adaptive; batch caps 8 MiB / 256 documents.
+            let handle = unsafe { dcreate(c_path.as_ptr(), cpu_workers, 8 << 20, 256, 0) };
+            if handle.is_null() {
+                return Err(Error::msg(format!("gtok_dispatcher_create failed for {path}")));
+            }
+            tracing::info!(cpu_workers, "GraphTok dispatcher enabled");
+            Some(Dispatch { handle, encode_fn: dencode, destroy_fn: ddestroy })
+        } else {
+            None
+        };
+        let contexts = if dispatch.is_some() { 0 } else { contexts };
+        let mut pool: Vec<Ctx> = Vec::with_capacity(contexts);
+        for _ in 0..contexts {
+            let handle = unsafe { create_fn(c_path.as_ptr(), max_bytes) };
+            if handle.is_null() {
+                for c in pool.drain(..) {
+                    unsafe { destroy_fn(c.handle) };
+                }
+                return Err(Error::msg(format!("gtok_create failed for {path}")));
+            }
+            // At most one token per input byte; slack covers the empty-input case.
+            pool.push(Ctx { handle });
+        }
+
+        let tokenizer = Self {
+            dispatch,
+            pool: Mutex::new(pool),
+            available: Condvar::new(),
+            encode_fn,
+            destroy_fn,
+            max_bytes,
+            hf_decoder: HuggingFaceTokenizer::from_file(path)?,
+            _lib: lib,
+        };
+
+        let want = tokenizer.hf_decoder.encode(PROBE)?;
+        let got = tokenizer.gpu_encode(PROBE)?;
+        if got.as_slice() != want.token_ids() {
+            return Err(Error::msg(format!(
+                "GraphTok token ids differ from HuggingFace for {path}; refusing to load"
+            )));
+        }
+        // Name the library: the backend loads any library exposing this C ABI,
+        // and a benchmark must be able to prove which one served a run.
+        tracing::info!(contexts, max_bytes, lib = %lib_path, "native tokenizer library loaded");
+        Ok(tokenizer)
+    }
+
+    fn take(&self) -> Ctx {
+        let mut pool = self.pool.lock().unwrap_or_else(|e| e.into_inner());
+        loop {
+            if let Some(c) = pool.pop() {
+                return c;
+            }
+            pool = self.available.wait(pool).unwrap_or_else(|e| e.into_inner());
+        }
+    }
+
+    fn give_back(&self, c: Ctx) {
+        self.pool.lock().unwrap_or_else(|e| e.into_inner()).push(c);
+        self.available.notify_one();
+    }
+
+    fn gpu_encode(&self, input: &str) -> Result<Vec<TokenIdType>> {
+        // The library writes the ids straight into the Vec the Encoding will
+        // own: no staging buffer and no copy. A byte-level BPE emits at most
+        // one token per input byte; NFC can lengthen the input slightly, hence
+        // the margin, and the library reports -2 rather than overrun `cap`.
+        let cap = input.len() + input.len() / 8 + 16;
+        let mut ids: Vec<TokenIdType> = Vec::with_capacity(cap);
+        if let Some(d) = &self.dispatch {
+            let r = unsafe {
+                (d.encode_fn)(d.handle, input.as_ptr(), input.len() as u32, ids.as_mut_ptr(), cap as u32)
+            };
+            if r < 0 {
+                return Err(Error::msg(format!("gtok_dispatch_encode error {r}")));
+            }
+            // SAFETY: the library initialised exactly r <= cap elements.
+            unsafe { ids.set_len(r as usize) };
+            return Ok(ids);
+        }
+        let c = self.take();
+        let r = unsafe {
+            (self.encode_fn)(c.handle, input.as_ptr(), input.len() as u32, ids.as_mut_ptr(), cap as u32)
+        };
+        self.give_back(c);
+        if r < 0 {
+            return Err(Error::msg(format!("gtok_encode error {r}")));
+        }
+        // SAFETY: the library initialised exactly r <= cap elements.
+        unsafe { ids.set_len(r as usize) };
+        Ok(ids)
+    }
+}
+
+impl Drop for GraphTokTokenizer {
+    fn drop(&mut self) {
+        if let Some(d) = self.dispatch.take() {
+            unsafe { (d.destroy_fn)(d.handle) };
+        }
+        let pool = self.pool.get_mut().unwrap_or_else(|e| e.into_inner());
+        for c in pool.drain(..) {
+            unsafe { (self.destroy_fn)(c.handle) };
+        }
+    }
+}
+
+impl Encoder for GraphTokTokenizer {
+    fn encode(&self, input: &str) -> Result<Encoding> {
+        if input.len() <= self.max_bytes as usize {
+            match self.gpu_encode(input) {
+                Ok(ids) => return Ok(Encoding::Sp(ids)),
+                Err(e) => tracing::warn!(%e, "GraphTok encode failed; using HuggingFace"),
+            }
+        } else {
+            // Never silent: an oversize input is encoded by HuggingFace, and a
+            // benchmark must be able to see that it did not measure GraphTok.
+            tracing::warn!(
+                bytes = input.len(),
+                max_bytes = self.max_bytes,
+                "GraphTok input exceeds DYN_GRAPHTOK_MAX_BYTES; using HuggingFace"
+            );
+        }
+        self.hf_decoder.encode(input)
+    }
+
+    fn encode_batch(&self, inputs: &[&str]) -> Result<Vec<Encoding>> {
+        inputs.iter().map(|s| self.encode(s)).collect()
+    }
+}
+
+impl Decoder for GraphTokTokenizer {
+    fn decode(&self, token_ids: &[TokenIdType], skip_special_tokens: bool) -> Result<DecodeResult> {
+        self.hf_decoder.decode(token_ids, skip_special_tokens)
+    }
+}
+
+impl Tokenizer for GraphTokTokenizer {}
